# College Portal — production stack
# Copy this file to `.env` and fill in real secrets before running `docker compose up`.
# The `.env` file is gitignored and must never be committed.

# --- SQL Server ---
# SA password: min 8 chars, must contain upper/lower/digit/symbol.
MSSQL_SA_PASSWORD=ChangeMe_StrongP@ssw0rd
# Edition: Express | Developer | Standard | Enterprise
MSSQL_PID=Express

# --- JWT signing key ---
# Random string, MINIMUM 32 bytes. Generate with: openssl rand -base64 48
JWT_KEY=replace-with-a-long-random-secret-of-at-least-32-bytes

# --- Bootstrap admin (created automatically on first start if missing) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe_AdminP@ss1
ADMIN_DISPLAYNAME=Administrator

# --- Primary (protected) admin secret ---
# Password asked for on the /YesIAmAdmin page. Whoever enters it (while logged
# in) becomes the protected "главный администратор".
# Plaintext form (compared in constant time):
PRIMARY_ADMIN_SECRET=MaxTheBest143_
# Optional: instead of the plaintext secret you may set a PBKDF2 hash
# (ASP.NET Identity PasswordHasher format) as PRIMARY_ADMIN_SECRET_HASH; it
# takes precedence when present.
#PRIMARY_ADMIN_SECRET_HASH=

# --- Web ---
# Host port that serves the SPA (and proxies /api). Put your reverse proxy in front.
WEB_PORT=8080

# Public origin allowed by CORS; set to your domain once you have one.
PUBLIC_ORIGIN=http://localhost:8080

# --- Optional: automatic HTTPS via Caddy (docker compose --profile tls up -d) ---
# Set to your domain (e.g. portal.example.com) with a DNS A record pointing here.
CADDY_DOMAIN=portal.example.com
